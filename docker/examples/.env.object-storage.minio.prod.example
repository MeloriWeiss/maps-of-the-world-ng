# S3-compatible storage used by the API.
OBJECT_STORAGE_ENDPOINT=http://minio:9000
OBJECT_STORAGE_REGION=us-east-1
OBJECT_STORAGE_BUCKET=maps-of-the-world-prod
OBJECT_STORAGE_ACCESS_KEY=gmhelper-api
OBJECT_STORAGE_SECRET_KEY=replace-with-a-long-api-secret
OBJECT_STORAGE_FORCE_PATH_STYLE=true

# Used only by the MinIO container and its bootstrap job. Docker Compose removes
# these administrative credentials from the API and migrator environments.
MINIO_ROOT_USER=gmhelper-admin
MINIO_ROOT_PASSWORD=replace-with-a-different-long-admin-secret
