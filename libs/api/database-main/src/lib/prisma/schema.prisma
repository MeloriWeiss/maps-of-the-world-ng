generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           Int    @id @default(autoincrement())
  email        String @unique
  username     String @unique
  passwordHash String @map("password_hash")

  personalAccount PersonalAccount? @relation("UserPersonalAccount")
  sessions        UserSession[]

  @@map("users")
}

model Map {
  id            Int     @id @default(autoincrement())
  name          String
  body          String
  description   String?
  isPublished   Boolean @default(false) @map("is_published")
  likesCount    Int     @default(0) @map("likes_count")
  commentsCount Int     @default(0) @map("comments_count")
  accountId     Int     @map("account_id")

  // relations
  authorAccount PersonalAccount @relation(fields: [accountId], references: [id])
  comments      MapComment[]

  @@map("maps")
}

model Texture {
  id        String   @id @default(uuid())
  name      String
  objectKey String   @unique @map("object_key")
  mimeType  String   @map("mime_type")
  size      Int
  width     Int?
  height    Int?
  createdAt DateTime @default(now()) @map("created_at")

  accountId Int             @map("account_id")
  owner     PersonalAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId, createdAt])
  @@map("textures")
}

model MapComment {
  id       Int    @id @default(autoincrement())
  comment  String
  mapId    Int    @map("map_id")
  authorId Int    @map("author_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // relations
  map           Map             @relation(fields: [mapId], references: [id])
  authorAccount PersonalAccount @relation(fields: [authorId], references: [id])

  @@map("map_comments")
}

model Forum {
  id       Int    @id @default(autoincrement())
  title    String
  post     String
  authorId Int    @map("author_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // relations
  authorAccount PersonalAccount @relation(fields: [authorId], references: [id])
  comments      ForumComment[]

  @@map("forums")
}

model ForumComment {
  id       Int    @id @default(autoincrement())
  comment  String
  forumId  Int    @map("forum_id")
  authorId Int    @map("author_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // relations
  forum         Forum           @relation(fields: [forumId], references: [id])
  authorAccount PersonalAccount @relation(fields: [authorId], references: [id])

  @@map("forum_comments")
}

model PersonalAccount {
  id Int @id @default(autoincrement())

  nickname String

  firstName  String? @map("first_name")
  lastName   String? @map("last_name")
  middleName String? @map("middle_name")

  phoneNumber String? @map("phone_number")
  birthDate   String? @map("birth_date")
  bio         String?

  avatarUrl String? @map("avatar_url")

  language String?
  theme    AppTheme @default(DEFAULT)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // relations
  userId Int  @unique @map("user_id")
  user   User @relation("UserPersonalAccount", fields: [userId], references: [id], onDelete: Cascade)

  maps          Map[]
  mapComments   MapComment[]
  forums        Forum[]
  forumComments ForumComment[]
  textures      Texture[]

  @@map("accounts")
}

model UserSession {
  id         Int      @id @default(autoincrement())
  tokenHash  String   @map("token_hash")
  userAgent  String?  @map("user_agent")
  ip         String?
  lastUsedAt DateTime @default(now()) @map("last_used_at")
  expiresAt  DateTime @map("expires_at")

  createdAt DateTime @default(now()) @map("created_at")

  // relations
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId Int  @map("user_id")

  @@map("sessions")
}

enum AppTheme {
  DEFAULT @map("default")
  LIGHT   @map("light")
  DARK    @map("dark")
}
