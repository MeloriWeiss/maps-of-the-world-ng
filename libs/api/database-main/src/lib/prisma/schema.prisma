generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           Int    @id @default(autoincrement())
  email        String @unique
  username     String @unique
  passwordHash String @map("password_hash")
  role         UserRole @default(USER)
  status       UserStatus @default(ACTIVE)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at")

  personalAccount PersonalAccount? @relation("UserPersonalAccount")
  sessions        UserSession[]
  auditLogs       AdminAuditLog[] @relation("AuditActor")

  @@map("users")
}

enum UserRole {
  USER
  ADMIN
  SUPER_ADMIN
}

enum UserStatus {
  ACTIVE
  BLOCKED
}

model AdminAuditLog {
  id         Int      @id @default(autoincrement())
  action     String
  targetType String   @map("target_type")
  targetId   String   @map("target_id")
  details    Json?
  createdAt  DateTime @default(now()) @map("created_at")

  actorId Int  @map("actor_id")
  actor   User @relation("AuditActor", fields: [actorId], references: [id], onDelete: Restrict)

  @@index([createdAt])
  @@index([actorId, createdAt])
  @@map("admin_audit_logs")
}

model SiteVisit {
  id        BigInt   @id @default(autoincrement())
  sessionId String   @unique @map("session_id") @db.Uuid
  visitorId String?  @map("visitor_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@index([visitorId, createdAt])
  @@map("site_visits")
}

model Map {
  revision      Int     @default(0)
  overviewKey   String? @map("overview_key")
  chunks        MapChunk[]
  scenePages    MapScenePage[]
  sceneObjects  MapSceneObject[]
  sceneObjectParts MapSceneObjectPart[]
  sceneContainers MapSceneContainer[]
  sceneTiles    MapSceneTile[]
  sceneCommits  MapSceneCommit[]
  id            Int     @id @default(autoincrement())
  name          String
  body          String
  description   String?
  isPublished   Boolean @default(false) @map("is_published")
  isHidden      Boolean @default(false) @map("is_hidden")
  likesCount    Int     @default(0) @map("likes_count")
  commentsCount Int     @default(0) @map("comments_count")
  accountId     Int     @map("account_id")

  // relations
  authorAccount PersonalAccount @relation(fields: [accountId], references: [id])
  comments      MapComment[]
  likes         MapLike[]

  @@map("maps")
}

model Texture {
  kind      TextureKind @default(SURFACE)
  deletedAt DateTime? @map("deleted_at")
  id        String   @id @default(uuid())
  name      String
  objectKey String   @unique @map("object_key")
  mimeType  String   @map("mime_type")
  size      Int
  width     Int?
  height    Int?
  createdAt DateTime @default(now()) @map("created_at")

  accountId Int             @map("account_id")
  owner     PersonalAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  packId    String          @map("pack_id")
  pack      TexturePack     @relation(fields: [packId], references: [id], onDelete: Cascade)
  sceneReferences MapSceneTextureRef[]

  @@index([accountId, createdAt])
  @@index([packId, createdAt])
  @@index([deletedAt])
  @@map("textures")
}

model MapChunk {
  mapId Int @map("map_id")
  key   String
  body  String
  map   Map @relation(fields: [mapId], references: [id], onDelete: Cascade)

  @@id([mapId, key])
  @@map("map_chunks")
}

model MapScenePage {
  mapId     Int    @map("map_id")
  cellX     Int    @map("cell_x")
  cellY     Int    @map("cell_y")
  pageId    Int    @map("page_id")
  minX      Float  @map("min_x")
  minY      Float  @map("min_y")
  maxX      Float  @map("max_x")
  maxY      Float  @map("max_y")
  body      String
  map       Map    @relation(fields: [mapId], references: [id], onDelete: Cascade)
  textures  MapSceneTextureRef[]

  @@id([mapId, cellX, cellY, pageId])
  @@index([mapId, cellX, cellY])
  @@index([mapId, minX, maxX])
  @@index([mapId, minY, maxY])
  @@map("map_scene_pages")
}

model MapSceneTextureRef {
  mapId     Int    @map("map_id")
  cellX     Int    @map("cell_x")
  cellY     Int    @map("cell_y")
  pageId    Int    @map("page_id")
  textureId String @map("texture_id")
  page      MapScenePage @relation(fields: [mapId, cellX, cellY, pageId], references: [mapId, cellX, cellY, pageId], onDelete: Cascade)
  texture   Texture @relation(fields: [textureId], references: [id], onDelete: Restrict)

  @@id([mapId, cellX, cellY, pageId, textureId])
  @@index([textureId])
  @@map("map_scene_texture_refs")
}

model TextureBlobCleanup {
  objectKey String @id @map("object_key")
  notBefore DateTime @map("not_before")

  @@index([notBefore])
  @@map("texture_blob_cleanup")
}

model MapSceneObject {
  mapId       Int     @map("map_id")
  objectId    String  @map("object_id")
  nodeId      String  @map("node_id")
  parentId    String  @map("parent_id")
  kind        String
  name        String
  minX        Float   @map("min_x")
  minY        Float   @map("min_y")
  maxX        Float   @map("max_x")
  maxY        Float   @map("max_y")
  partCount   Int     @default(1) @map("part_count")
  map         Map     @relation(fields: [mapId], references: [id], onDelete: Cascade)

  @@id([mapId, objectId])
  @@index([mapId, minX, maxX])
  @@index([mapId, minY, maxY])
  @@index([mapId, kind, name])
  @@index([mapId, parentId])
  @@map("map_scene_objects")
}

model MapSceneObjectPart {
  mapId     Int    @map("map_id")
  objectId  String @map("object_id")
  partId    String @map("part_id")
  cellX     Int    @map("cell_x")
  cellY     Int    @map("cell_y")
  pageId    Int    @map("page_id")
  minX      Float  @map("min_x")
  minY      Float  @map("min_y")
  maxX      Float  @map("max_x")
  maxY      Float  @map("max_y")
  map       Map    @relation(fields: [mapId], references: [id], onDelete: Cascade)

  @@id([mapId, partId])
  @@index([mapId, objectId])
  @@index([mapId, cellX, cellY, pageId])
  @@map("map_scene_object_parts")
}

model MapSceneContainer {
  mapId     Int     @map("map_id")
  id        String
  parentId  String? @map("parent_id")
  kind      String
  name      String
  visible   Boolean @default(true)
  locked    Boolean @default(false)
  orderKey  Float   @map("order_key")
  childIndex Int    @default(0) @map("child_index")
  map       Map     @relation(fields: [mapId], references: [id], onDelete: Cascade)

  @@id([mapId, id])
  @@index([mapId, parentId, orderKey])
  @@map("map_scene_containers")
}

model MapSceneTile {
  mapId      Int     @map("map_id")
  level      Int
  x          Int
  y          Int
  objectKey  String? @map("object_key")
  version    Int
  map        Map     @relation(fields: [mapId], references: [id], onDelete: Cascade)

  @@id([mapId, level, x, y])
  @@index([mapId, level])
  @@map("map_scene_tiles")
}

model MapSceneCommit {
  id               String   @id @default(uuid())
  mapId            Int      @map("map_id")
  accountId        Int      @map("account_id")
  expectedRevision Int      @map("expected_revision")
  sourceMapId      Int?     @map("source_map_id")
  sourceRevision   Int?     @map("source_revision")
  sourceTilesReady Boolean  @default(false) @map("source_tiles_ready")
  copyCursor       String?  @map("copy_cursor")
  idempotencyKey   String   @map("idempotency_key")
  status           String   @default("uploading")
  header           String?
  createdAt        DateTime @default(now()) @map("created_at")
  expiresAt        DateTime @map("expires_at")
  pages            MapSceneCommitPage[]
  tiles            MapSceneCommitTile[]
  map              Map      @relation(fields: [mapId], references: [id], onDelete: Cascade)

  @@unique([mapId, idempotencyKey])
  @@index([accountId, expiresAt])
  @@map("map_scene_commits")
}

model MapSceneCommitPage {
  commitId String @map("commit_id")
  cellX    Int    @map("cell_x")
  cellY    Int    @map("cell_y")
  pageId   Int    @map("page_id")
  minX     Float  @map("min_x")
  minY     Float  @map("min_y")
  maxX     Float  @map("max_x")
  maxY     Float  @map("max_y")
  body     String
  deleted  Boolean @default(false)
  commit   MapSceneCommit @relation(fields: [commitId], references: [id], onDelete: Cascade)

  @@id([commitId, cellX, cellY, pageId])
  @@map("map_scene_commit_pages")
}

model MapSceneCommitTile {
  commitId  String  @map("commit_id")
  level     Int
  x         Int
  y         Int
  objectKey String? @map("object_key")
  commit    MapSceneCommit @relation(fields: [commitId], references: [id], onDelete: Cascade)

  @@id([commitId, level, x, y])
  @@map("map_scene_commit_tiles")
}

model MapSceneBlobCleanup {
  objectKey String   @id @map("object_key")
  notBefore DateTime @map("not_before")

  @@index([notBefore])
  @@map("map_scene_blob_cleanup")
}

enum TextureKind {
  SURFACE
  STAMP
}

model TexturePack {
  id          String    @id @default(uuid())
  name        String
  description String?
  isPublished Boolean   @default(false) @map("is_published")
  isHidden    Boolean   @default(false) @map("is_hidden")
  deletedAt   DateTime? @map("deleted_at")
  likesCount  Int       @default(0) @map("likes_count")
  publishedAt DateTime? @map("published_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  accountId Int               @map("account_id")
  owner     PersonalAccount   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  textures  Texture[]
  likes     TexturePackLike[]

  @@index([accountId, updatedAt])
  @@index([isPublished, publishedAt])
  @@index([deletedAt])
  @@map("texture_packs")
}

model MapComment {
  id       Int    @id @default(autoincrement())
  comment  String
  mapId    Int    @map("map_id")
  authorId Int    @map("author_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // relations
  map           Map             @relation(fields: [mapId], references: [id])
  authorAccount PersonalAccount @relation(fields: [authorId], references: [id])

  @@map("map_comments")
}

model MapLike {
  accountId Int      @map("account_id")
  mapId     Int      @map("map_id")
  createdAt DateTime @default(now()) @map("created_at")

  account PersonalAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  map     Map             @relation(fields: [mapId], references: [id], onDelete: Cascade)

  @@id([accountId, mapId])
  @@index([accountId, createdAt])
  @@map("map_likes")
}

model TexturePackLike {
  accountId     Int      @map("account_id")
  texturePackId String   @map("texture_pack_id")
  createdAt     DateTime @default(now()) @map("created_at")

  account     PersonalAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  texturePack TexturePack     @relation(fields: [texturePackId], references: [id], onDelete: Cascade)

  @@id([accountId, texturePackId])
  @@index([accountId, createdAt])
  @@map("texture_pack_likes")
}

model Forum {
  id            Int    @id @default(autoincrement())
  title         String
  post          String
  likesCount    Int    @default(0) @map("likes_count")
  commentsCount Int    @default(0) @map("comments_count")
  authorId      Int    @map("author_id")
  categoryId    Int    @map("category_id")
  isHidden      Boolean @default(false) @map("is_hidden")
  isPinned      Boolean @default(false) @map("is_pinned")
  isClosed      Boolean @default(false) @map("is_closed")
  lastActivityAt DateTime @default(now()) @map("last_activity_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // relations
  authorAccount PersonalAccount @relation(fields: [authorId], references: [id])
  category      ForumCategory   @relation(fields: [categoryId], references: [id])
  comments      ForumComment[]
  likes         ForumLike[]

  @@index([categoryId, createdAt])
  @@index([isHidden, isPinned, lastActivityAt])
  @@map("forums")
}

model ForumCategory {
  id          Int     @id @default(autoincrement())
  slug        String  @unique
  title       String
  description String?
  sortOrder   Int     @default(0) @map("sort_order")

  discussions Forum[]

  @@map("forum_categories")
}

model ForumComment {
  id       Int    @id @default(autoincrement())
  comment  String
  forumId  Int    @map("forum_id")
  authorId Int    @map("author_id")
  parentId Int?   @map("parent_id")
  isHidden Boolean @default(false) @map("is_hidden")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // relations
  forum         Forum           @relation(fields: [forumId], references: [id], onDelete: Cascade)
  authorAccount PersonalAccount @relation(fields: [authorId], references: [id])
  parent        ForumComment?   @relation("ForumCommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies       ForumComment[]  @relation("ForumCommentReplies")

  @@index([forumId, createdAt])
  @@index([parentId])
  @@map("forum_comments")
}

model ForumLike {
  accountId Int      @map("account_id")
  forumId   Int      @map("forum_id")
  createdAt DateTime @default(now()) @map("created_at")

  account PersonalAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  forum   Forum           @relation(fields: [forumId], references: [id], onDelete: Cascade)

  @@id([accountId, forumId])
  @@index([accountId, createdAt])
  @@map("forum_likes")
}

model PersonalAccount {
  id Int @id @default(autoincrement())

  nickname String

  firstName  String? @map("first_name")
  lastName   String? @map("last_name")
  middleName String? @map("middle_name")

  phoneNumber String? @map("phone_number")
  birthDate   String? @map("birth_date")
  bio         String?

  avatarUrl String? @map("avatar_url")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // relations
  userId Int  @unique @map("user_id")
  user   User @relation("UserPersonalAccount", fields: [userId], references: [id], onDelete: Cascade)

  maps              Map[]
  mapComments       MapComment[]
  forums            Forum[]
  forumComments     ForumComment[]
  forumLikes        ForumLike[]
  textures          Texture[]
  texturePacks      TexturePack[]
  likedMaps         MapLike[]
  likedTexturePacks TexturePackLike[]

  @@map("accounts")
}

model UserSession {
  id         Int      @id @default(autoincrement())
  tokenHash  String   @map("token_hash")
  userAgent  String?  @map("user_agent")
  ip         String?
  lastUsedAt DateTime @default(now()) @map("last_used_at")
  expiresAt  DateTime @map("expires_at")

  createdAt DateTime @default(now()) @map("created_at")

  // relations
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId Int  @map("user_id")

  @@map("sessions")
}
